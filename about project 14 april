from functools import wraps

def mod_required(view_func):
    @wraps(view_func)
    def wrapper(request, *args, **kwargs):
        if not request.user.is_authenticated or request.user.role_type not in ['MAINTAINER','ADMIN']:
            messages.error(request, 'Access denied.')
            return redirect('registry:homepage')
        return view_func(request, *args, **kwargs)
    return wrapper

def search(request):
    q = request.GET.get('q', '').strip()
    results = {'machines': [], 'reports': [], 'components': [], 'distros': []}
    total = 0
    if q:
        # Machines: Search vendor, model, series, and even CPU/GPU info if specs exist
        results['machines'] = Machine.objects.filter(
            Q(vendor__icontains=q) | 
            Q(model_name__icontains=q) | 
            Q(series__icontains=q) |
            Q(spec__cpu_name__icontains=q) |
            Q(spec__gpu_name__icontains=q)
        ).distinct().annotate(report_count=Count('reports'))[:12]

        # Reports: Search title, description, and component status notes (the "issues")
        results['reports'] = Report.objects.filter(
            Q(title__icontains=q) | 
            Q(description__icontains=q) |
            Q(comp_statuses__notes__icontains=q) |
            Q(machine__model_name__icontains=q),
            status='APPROVED'
        ).distinct().select_related('user', 'machine', 'distro')[:15]

        # Components: Search name, driver, and type
        results['components'] = Component.objects.filter(
            Q(name__icontains=q) | 
            Q(driver__icontains=q) |
            Q(type__icontains=q)
        ).distinct()[:10]

        # Distros: Search name and version
        results['distros'] = Distro.objects.filter(
            Q(name__icontains=q) | 
            Q(version__icontains=q)
        ).distinct()[:6]

        total = sum(len(v) for v in results.values())
    
    return render(request, 'registry/search.html', {
        'q': q,
        'results': results,
        'total': total
    })

